# Copy this file to .env.local (recommended) or .env and fill in the values.

# MongoDB connection string (required)
# Used for users, auth, and sales data.
# You can omit the database name in the URI if MONGODB_DB_NAME is set below.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# MongoDB database name (optional)
# Overrides the database name from MONGODB_URI when set.
MONGODB_DB_NAME=ai-sales-chatbot

# OpenRouter API key (required for AI chat)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Auth.js session signing secret (required)
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# App base URL (recommended; required in production)
AUTH_URL=http://localhost:3000
